{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Goop",
  "version": "0.3.2",
  "identifier": "dev.goop.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Goop",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/goop/thumbs/**",
          "$HOME/Library/Application Support/goop/thumbs/**",
          "$APPDATA/goop/thumbs/**",
          "$DATA/goop/page-thumbs/**",
          "$HOME/Library/Application Support/goop/page-thumbs/**",
          "$APPDATA/goop/page-thumbs/**",
          "$HOME/**",
          "$DESKTOP/**",
          "$DOWNLOAD/**",
          "$DOCUMENT/**",
          "$PICTURE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["bin/ffmpeg", "bin/ffprobe", "bin/yt-dlp", "bin/gallery-dl", "bin/gs", "bin/mutool", "bin/tesseract"],
    "resources": {
      "bin/gs-resources/Resource": "gs-resources/Resource",
      "bin/gs-resources/lib": "gs-resources/lib",
      "bin/gs-resources/iccprofiles": "gs-resources/iccprofiles",
      "bin/tesseract-data/eng.traineddata": "tesseract-data/eng.traineddata",
      "../src/assets/fonts/bricolage-grotesque-OFL.txt": "licenses/fonts/bricolage-grotesque-OFL.txt",
      "../src/assets/fonts/figtree-OFL.txt": "licenses/fonts/figtree-OFL.txt"
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  }
}
