# Rust
/target
**/*.rs.bk
Cargo.lock

# ts-rs per-crate dependency bindings (regenerated on each `cargo test`)
/crates/*/bindings/
/crates/shared/

# Node
node_modules
dist
/src-tauri/target

# TypeScript incremental build + accidental tsc emit (we use Vite for builds)
tsconfig.tsbuildinfo
/src/**/*.js
/src/**/*.test.js
/shared/**/*.js


# Editor
.idea
.vscode/*
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db

# Goop
# generate-bindings.sh staging tree (removed on exit; ignored so a killed run
# can never be committed and never masquerades as real bindings)
/.bindings-stage.*
# sidecar binaries fetched by fetch-sidecars.sh
/src-tauri/bin/
# macOS sidecar dylib bundle map — generated per-build by fetch-sidecars.sh
# from the actual src-tauri/bin/*.dylib set; Tauri auto-merges it over
# tauri.conf.json for macOS builds (see scripts/fetch-sidecars.sh).
/src-tauri/tauri.macos.conf.json
# auto-generated by tauri-build
/src-tauri/gen/schemas/
.worktrees/

# Generated rustdoc output (`cargo doc`)
/doc/

# Local working notes (not for the public repo)
/docs/

# Release notes are applied via gh release edit; not tracked
.release-notes/
# No trailing slash: a directory in the main checkout, a symlink in linked
# worktrees. A dir-only pattern would not match the symlink.
/.heif-deps
